{
  "name": "kontakter",
  "version": "1.0.0",
  "private": true,
  "description": "Kontakter - eksempelapp for kurset JavaScript Grunnkurs (ITFakultetet). Express 5 + EJS + PostgreSQL.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "db:init": "node scripts/db-init.js",
    "test": "node --env-file-if-exists=.env --env-file-if-exists=.env.test --test tests/",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "bootstrap": "5.3.9",
    "dotenv": "18.0.10",
    "ejs": "7.0.2",
    "express": "5.3.0",
    "helmet": "8.3.0",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.15.0",
    "pino-pretty": "13.2.0",
    "prettier": "3.10.1",
    "supertest": "7.3.2"
  }
}
