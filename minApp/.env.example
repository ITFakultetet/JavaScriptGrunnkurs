# ------------------------------------------------------------------------------
# Kopier denne filen til .env og fyll inn dine egne verdier:
#
#   cp .env.example .env
#
# .env er utelatt i .gitignore og skal ALDRI committes. Denne filen (.env.example)
# inneholder bare PLASSHOLDERE, aldri ekte passord.
# ------------------------------------------------------------------------------

# development | test | production
NODE_ENV=development

# Porten HTTP-serveren lytter på
PORT=3000

# Tilkoblingen til PostgreSQL. Passordet må byttes til det du satte i
# docker-compose.yml (POSTGRES_PASSWORD).
DATABASE_URL=postgres://jsgk:bytt-til-ditt-eget-passord@localhost:5432/jsgk

# Maks antall samtidige tilkoblinger i poolen
DB_POOL_STOERRELSE=10

# debug under utvikling, info i produksjon
LOG_LEVEL=debug
